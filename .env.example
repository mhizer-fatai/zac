# API port (default 8787). The production server also serves dist/.
PORT=8787

# Where the signed name records are stored. Mount a persistent disk in production.
# ZAC_DATA_DIR=./server/data

# Optional: store claims in Postgres instead of the JSON file (for hosts without a
# persistent disk, e.g. Render free + a free Neon database). Never commit the real value.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: absolute API origin if the UI is hosted separately from the API.
# VITE_API_BASE_URL=https://api.example.com

# Optional: shown in Settings as the source repository.
# VITE_SOURCE_URL=https://github.com/yourname/zac
